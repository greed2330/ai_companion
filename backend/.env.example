OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_WORKER_MODEL=qwen3:4b
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
DB_PATH=data/hana.db
REDIS_URL=redis://localhost:6379/0
CHROMA_PATH=data/chroma

# TTS (Kokoro-ONNX) — 모델 다운로드: https://huggingface.co/hexgrad/Kokoro-82M
# kokoro-v1_0.onnx 와 voices-v1_0.bin 을 data/ 디렉토리에 저장
KOKORO_MODEL_PATH=data/kokoro-v1_0.onnx
KOKORO_VOICES_PATH=data/voices-v1_0.bin
KOKORO_VOICE=kf_bella

# STT (Whisper) — tiny/base/small/medium/large
WHISPER_MODEL=base
